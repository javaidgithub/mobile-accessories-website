
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# ALLOWED_ORIGINS: Comma-separated list of origins allowed to call the API in production
# (CORS). Example: "https://myshop.com,https://admin.myshop.com"
# In development, if left unset, all origins are allowed for convenience.
ALLOWED_ORIGINS=""

# Admin account bootstrap values. These are ONLY used the very first time the
# database is created (data/app.db). Changing them afterwards has no effect —
# update credentials from the Admin > Profile page instead.
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@apexmobiletech.com"
ADMIN_PASSWORD="change-this-before-first-run"
