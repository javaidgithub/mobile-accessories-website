# Dependencies
node_modules/

# Build output
build/
dist/
coverage/

# Environment variables (never commit real secrets)
.env
.env.local
.env.*.local
!.env.example

# Database (created automatically on first run — do not commit)
data/*.db
data/*.db-shm
data/*.db-wal
data/db.json

# Uploaded images (user-generated content, not source code)
public/uploads/*
!public/uploads/.gitkeep

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/*
!.vscode/extensions.json
.idea/

# Vite / esbuild cache
.vite/
*.tsbuildinfo